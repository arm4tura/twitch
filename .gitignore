# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ── Node / Electron ───────────────────────────────────────
node_modules/
dist/
build/
release/
.vite/
.turbo/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# electron-builder buildResources (иконка нужна в репо, не игнорируем)
!desktop/build/
!desktop/build/**

# TwitchDownloaderCLI бинарники бандлятся при сборке, но НЕ коммитятся
# (большие, лицензия отдельная). Держим только структуру папок + README:
# см. desktop/build/tdcli/README.md — куда класть бинарник под каждую платформу.
desktop/build/tdcli/**/TwitchDownloaderCLI
desktop/build/tdcli/**/TwitchDownloaderCLI.exe

# ── Media (large binaries) ────────────────────────────────
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.wav
*.mp3
*.flac
*.m4a
*.sfk

# ── Personal config (keep only *.example.*) ───────────────
backend/banwords.txt

# ── Models / weights ──────────────────────────────────────
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.ggml

# ── Job artifacts (keep folders, ignore contents) ─────────
work/*
!work/.gitkeep
models/*
!models/.gitkeep

# Реестр «недавних проектов» (в dev DATA_ROOT = корень репо)
projects.json

# ── Vendored binaries (скачиваются в dev, не коммитятся) ───
# TwitchDownloaderCLI + его лицензии кладутся сюда локально для dev-запуска
# (см. desktop/build/tdcli/README.md). Большие и лицензированы отдельно.
vendor/

# ── Runtime cache ─────────────────────────────────────────
cache/

# ── OS / editor ───────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
